# Copy to config.env (gitignored) and fill in your values.
# Read by scripts/connect.sh and by aimode-mcp (real env vars override it).

# Mac running aimode
AI_MAC_HOST=
AI_MAC_PORT=8080
AI_MAC_API_KEY=

# SSH: install.sh writes a `Host ai-mac` block for AI_MAC_HOST/AI_MAC_USER.
AI_MAC_USER=
AI_MAC_SSH=ai-mac
# aimode on the Mac — absolute path, a non-interactive ssh has a bare PATH.
AI_MAC_AIMODE=aimode
# Optional: Mac's Ethernet MAC address — the job worker / ensure_profile wake it with WoL.
AI_MAC_WOL_MAC=

# Optional: command that receives a one-line job summary on stdin when an async job finishes
# (e.g. a Telegram/email sender).
AIMODE_NOTIFY_CMD=
